{
  "rewrites": [
    {
      "source": "/product/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Telegram|Twitterbot).*"
        }
      ],
      "destination": "/api/og?id=:id"
    },
    {
      "source": "/product/:id",
      "destination": "/index.html"
    },
    {
      "source": "/item/:id",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}